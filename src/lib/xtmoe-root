#!/data/data/com.termux/files/usr/bin/bash
set -Eeuo pipefail

die() { printf '[Root 错误] %s\n' "$*" >&2; exit 1; }
warn() { printf '[Root 警告] %s\n' "$*" >&2; }
ok() { printf '[Root] %s\n' "$*"; }

declare -a GUEST_PROXY_ENV=() PROXY_HELPER_ARGS=()

# Resolve each link relative to the guest root, never the Android host root.
# In particular, /etc/alternatives links commonly contain absolute targets.
rootfs_resolve_path() {
    local root_real resolved pending=${2#/} component target links=0
    root_real=$(realpath -m -- "$1"); resolved=$root_real
    while [[ -n $pending ]]; do
        component=${pending%%/*}
        if [[ $pending == */* ]]; then pending=${pending#*/}; else pending=''; fi
        case "$component" in
            ''|.) continue ;;
            ..) [[ $resolved != "$root_real" ]] || return 1; resolved=${resolved%/*} ;;
            *)
                if [[ -L $resolved/$component ]]; then
                    ((links += 1)); ((links <= 40)) || return 1
                    target=$(readlink -- "$resolved/$component") || return 1
                    [[ -n $target ]] || return 1
                    if [[ $target == /* ]]; then resolved=$root_real; target=${target#/}; fi
                    pending="$target${pending:+/$pending}"
                else
                    resolved+=/$component
                fi
                ;;
        esac
    done
    printf '%s' "$resolved"
}

rootfs_has_executable() {
    local resolved
    resolved=$(rootfs_resolve_path "$1" "$2") || return 1
    [[ -f $resolved && -x $resolved ]]
}

rootfs_has_shell() {
    local rootfs=$1 candidate
    for candidate in /usr/bin/sh /bin/sh /usr/bin/bash; do
        rootfs_has_executable "$rootfs" "$candidate" && return 0
    done
    return 1
}

valid_container_tree() {
    local container=$1
    [[ -f $container/.xtmoe-chroot && ! -L $container/.xtmoe-chroot ]] || return 1
    grep -qx 'xtmoe-chroot-format-1' "$container/.xtmoe-chroot" || return 1
    [[ -d $container/rootfs && ! -L $container/rootfs ]] || return 1
    rootfs_has_shell "$container/rootfs"
}

rootfs_has_systemd_init() {
    local rootfs=$1
    rootfs_has_executable "$rootfs" /sbin/init || return 1
    rootfs_has_executable "$rootfs" /usr/lib/systemd/systemd ||
        rootfs_has_executable "$rootfs" /lib/systemd/systemd
}
[[ $(id -u) -eq 0 ]] || die '本助手必须由 xtmoe 通过 su/tsu 调用。'
[[ $# -gt 0 ]] || die '缺少 Termux PREFIX'
TERMUX_PREFIX=$1
shift
while [[ ${1:-} == --proxy-env ]]; do
    (($# >= 2)) || die '缺少代理环境值'
    case "$2" in
        http_proxy=*|HTTP_PROXY=*|https_proxy=*|HTTPS_PROXY=*|all_proxy=*|ALL_PROXY=*|no_proxy=*|NO_PROXY=*) ;;
        *) die '不允许传入非代理环境变量' ;;
    esac
    [[ $2 != *$'\n'* && $2 != *$'\r'* ]] || die '代理环境不能包含换行'
    GUEST_PROXY_ENV+=("$2")
    PROXY_HELPER_ARGS+=(--proxy-env "$2")
    shift 2
done
export PATH="$TERMUX_PREFIX/bin:/system/bin:/system/xbin:/vendor/bin:${PATH:-}"

valid_name() { [[ $1 =~ ^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$ ]]; }

mount_path_encode() {
    local path=$1
    path=${path//\\/\\134}
    path=${path//$'\t'/\\011}
    path=${path//$'\n'/\\012}
    path=${path// /\\040}
    printf '%s' "$path"
}

mount_path_decode() {
    local path=$1
    path=${path//\\040/ }
    path=${path//\\011/$'\t'}
    path=${path//\\012/$'\n'}
    path=${path//\\134/\\}
    printf '%s' "$path"
}

container_paths() {
    local requested_base=$1 requested_name=$2 parent
    valid_name "$requested_name" || die '非法容器名称'
    BASE=$(realpath -m -- "$requested_base")
    case "$BASE" in
        */files/home/.local/share/xtmoe/chroot) ;;
        *) die "拒绝操作非 XTMOE Chroot 目录：$BASE" ;;
    esac
    CONTAINER=$(realpath -m -- "$BASE/$requested_name")
    CONTAINER_NAME=$requested_name
    parent=$(dirname -- "$CONTAINER")
    [[ $parent == "$BASE" && $CONTAINER != / ]] || die '容器路径越界'
    ROOTFS="$CONTAINER/rootfs"
}

is_mounted() {
    local path
    path=$(mount_path_encode "$1")
    awk -v p="$path" '$2 == p || index($2, p "/") == 1 { found=1 } END { exit !found }' /proc/mounts
}

mount_one() {
    local source_path=$1 target=$2 mode=${3:-rw} source_real
    [[ -d $source_path ]] || die "挂载源不是目录：$source_path"
    source_real=$(realpath -m -- "$source_path")
    [[ $source_real != / && $source_real != /data ]] || die '拒绝挂载整个宿主根目录或 /data'
    [[ $target == /* && $target != / ]] || die '非法容器挂载点：$target'
    case "$target" in /dev|/dev/*|/proc|/proc/*|/sys|/sys/*|/run|/run/*) die "保留挂载点不能自定义：$target" ;; esac
    local destination
    destination=$(realpath -m -- "$ROOTFS$target")
    [[ $destination == "$ROOTFS"/* ]] || die "挂载点越界：$target"
    is_mounted "$destination" && return 0
    mkdir -p -- "$destination"
    mount --bind "$source_real" "$destination"
    mount --make-private "$destination" 2>/dev/null || true
    if [[ $mode == ro ]]; then
        mount -o remount,bind,ro "$source_real" "$destination"
    fi
}

apply_bind_config() {
    local config=${1:-} mode source_path target extra
    [[ -n $config && -s $config ]] || return 0
    while IFS='|' read -r mode source_path target extra; do
        [[ -n $mode && -z $extra ]] || die "挂载配置格式错误：$config"
        [[ $mode == ro || $mode == rw ]] || die '非法挂载模式'
        mount_one "$source_path" "$target" "$mode"
    done <"$config"
}

mount_all() {
    local config=${1:-} mount_proc=${2:-1}
    rootfs_has_shell "$ROOTFS" || die "无效 rootfs：$ROOTFS（缺少可执行的 /bin/sh）"
    mkdir -p "$ROOTFS"/{dev,proc,sys,run,tmp}
    if ! is_mounted "$ROOTFS"; then
        mount --bind "$ROOTFS" "$ROOTFS"
        mount --make-private "$ROOTFS" 2>/dev/null || true
    fi
    if [[ $mount_proc == 1 ]]; then
        is_mounted "$ROOTFS/proc" || mount -t proc proc "$ROOTFS/proc"
    fi
    if ! is_mounted "$ROOTFS/sys"; then
        mount --rbind /sys "$ROOTFS/sys"
        mount --make-rslave "$ROOTFS/sys" 2>/dev/null || mount --make-private "$ROOTFS/sys" 2>/dev/null || true
    fi
    if ! is_mounted "$ROOTFS/dev"; then
        mount --rbind /dev "$ROOTFS/dev"
        mount --make-rslave "$ROOTFS/dev" 2>/dev/null || mount --make-private "$ROOTFS/dev" 2>/dev/null || true
    fi
    is_mounted "$ROOTFS/run" || mount -t tmpfs -o mode=755,nosuid,nodev tmpfs "$ROOTFS/run"
    apply_bind_config "$config"
}

unmount_all() {
    local rootfs=$1 encoded_rootfs mounts target failed=0
    encoded_rootfs=$(mount_path_encode "$rootfs")
    mounts=$(awk -v p="$encoded_rootfs" '$2 == p || index($2, p "/") == 1 { print $2 }' /proc/mounts | awk '{ print length, $0 }' | sort -rn | cut -d' ' -f2-)
    while IFS= read -r target; do
        [[ -n $target ]] || continue
        target=$(mount_path_decode "$target")
        umount "$target" 2>/dev/null || failed=1
    done <<<"$mounts"
    return "$failed"
}

ensure_hosts_config() {
    local hostname_file hosts_file nsswitch_file tmp guest_hostname
    hostname_file=$(rootfs_resolve_path "$1" /etc/hostname) || die 'hostname 路径越界或链接循环'
    hosts_file=$(rootfs_resolve_path "$1" /etc/hosts) || die 'hosts 路径越界或链接循环'
    nsswitch_file=$(rootfs_resolve_path "$1" /etc/nsswitch.conf) || die 'nsswitch 路径越界或链接循环'
    [[ ! -d $hostname_file && ! -d $hosts_file && ! -d $nsswitch_file ]] || die '名称解析配置不能是目录'

    if [[ -s $hostname_file ]]; then
        guest_hostname=$(awk '!/^[[:space:]]*#/ && NF {print $1; exit}' "$hostname_file")
        [[ $guest_hostname =~ ^[A-Za-z0-9][A-Za-z0-9.-]{0,252}$ ]] || die 'hostname 配置无效；保留原文件，请先修正 /etc/hostname'
    else
        guest_hostname=localhost
        printf 'localhost\n' >"$hostname_file"
    fi
    if [[ ! -e $hosts_file ]]; then
        printf '127.0.0.1\tlocalhost\n::1\tlocalhost ip6-localhost ip6-loopback\n' >"$hosts_file"
    else
        awk '$1 == "127.0.0.1" { for (i = 2; i <= NF; i++) if ($i == "localhost") found = 1 } END { exit !found }' "$hosts_file" ||
            printf '127.0.0.1\tlocalhost\n' >>"$hosts_file"
        awk '$1 == "::1" { for (i = 2; i <= NF; i++) if ($i == "localhost") found = 1 } END { exit !found }' "$hosts_file" ||
            printf '::1\tlocalhost ip6-localhost ip6-loopback\n' >>"$hosts_file"
    fi
    if [[ $guest_hostname != localhost ]]; then
        awk -v name="$guest_hostname" '$1 !~ /^#/ { for (i = 2; i <= NF; i++) if ($i == name) found = 1 } END { exit !found }' "$hosts_file" ||
            printf '127.0.1.1\t%s\n' "$guest_hostname" >>"$hosts_file"
    fi
    # Repair existing "hosts: files" or systemd stub configurations as well.
    tmp="$nsswitch_file.xtmoe.$$"
    if [[ -f $nsswitch_file ]]; then
        awk '/^[[:space:]]*hosts:/ { if (!seen++) print "hosts: files dns"; next } { print } END { if (!seen) print "hosts: files dns" }' "$nsswitch_file" >"$tmp"
    else
        printf 'hosts: files dns\n' >"$tmp"
    fi
    chmod 0644 "$tmp"; mv -f -- "$tmp" "$nsswitch_file"
}

set_dns_config() {
    local rootfs=$1 dns file tmp etc_dir
    shift
    etc_dir=$(rootfs_resolve_path "$rootfs" /etc) || die '/etc 路径越界或链接循环'
    file="$etc_dir/resolv.conf"
    [[ -d $etc_dir ]] || die 'rootfs 缺少 /etc'
    [[ ! -d $file ]] || die '/etc/resolv.conf 不能是目录'
    tmp="$etc_dir/.resolv.conf.xtmoe.$$"
    : >"$tmp"
    for dns in "$@"; do
        [[ $dns =~ ^[0-9A-Fa-f:.]+$ ]] || { rm -f -- "$tmp"; die "非法 DNS 地址：$dns"; }
        printf 'nameserver %s\n' "$dns" >>"$tmp"
    done
    [[ -s $tmp ]] || { rm -f -- "$tmp"; die '至少需要一个 DNS 地址'; }
    rm -f -- "$file"
    mv -- "$tmp" "$file"
    chmod 0644 "$file"
    ensure_hosts_config "$rootfs"
    ok '已写入固定 DNS：1.1.1.1、8.8.8.8'
}

systemd_check_pass() { printf '[通过] %s\n' "$1"; }
systemd_check_fail() { printf '[缺失] %s\n' "$1" >&2; }
systemd_check_note() { printf '[警告] %s\n' "$1"; }

cgroup_mode() {
    if [[ -r /sys/fs/cgroup/cgroup.controllers ]] || awk '$3 == "cgroup2" { found=1 } END { exit !found }' /proc/mounts; then
        printf 'v2'
    elif awk '$3 == "cgroup" { found=1 } END { exit !found }' /proc/mounts; then
        printf 'v1'
    elif grep -qw cgroup2 /proc/filesystems; then
        printf 'v2-unmounted'
    elif grep -qw cgroup /proc/filesystems; then
        printf 'v1-unmounted'
    else
        printf 'none'
    fi
}

cgroup_has_controller() {
    local controller=$1 mode
    mode=$(cgroup_mode)
    case "$mode" in
        v2|v2-unmounted) grep -qw "$controller" /sys/fs/cgroup/cgroup.controllers 2>/dev/null ;;
        v1|v1-unmounted) awk -v expected="$controller" '$1 == expected && $4 == 1 { found=1 } END { exit !found }' /proc/cgroups ;;
        *) return 1 ;;
    esac
}

cgroup_v1_controller_mounted() {
    local controller=$1
    awk -v expected="$controller" '
        $3 == "cgroup" {
            count=split($4, options, ",")
            for (index=1; index <= count; index++) if (options[index] == expected) found=1
        }
        END { exit !found }
    ' /proc/mounts
}

cgroup_check() {
    local mode controllers=''
    mode=$(cgroup_mode)
    printf 'Kernel: %s\nMode: %s\nMounts:\n' "$(uname -r)" "$mode"
    awk '$3 == "cgroup" || $3 == "cgroup2" { print "  " $2 " (" $3 ")" }' /proc/mounts
    if [[ -r /sys/fs/cgroup/cgroup.controllers ]]; then
        controllers=$(cat /sys/fs/cgroup/cgroup.controllers)
        printf 'Available controllers: %s\n' "${controllers:-none}"
        printf 'Enabled subtree controllers: %s\n' "$(cat /sys/fs/cgroup/cgroup.subtree_control 2>/dev/null || printf unavailable)"
    else
        printf 'Enabled v1 controllers:\n'
        awk 'NR > 1 && $4 == 1 { print "  " $1 }' /proc/cgroups
    fi
    [[ -e /proc/self/ns/cgroup ]] && printf '[通过] cgroup namespace 文件存在\n' || printf '[警告] cgroup namespace 不存在\n'
    if unshare --cgroup --fork /bin/true >/dev/null 2>&1; then
        printf '[通过] 可创建 cgroup namespace\n'
    else
        printf '[警告] 无法创建 cgroup namespace，将使用兼容视图\n'
    fi
    case "$mode" in
        none) printf '[缺失] 内核未提供 cgroup 文件系统\n' >&2; return 1 ;;
        *-unmounted) printf '[警告] cgroup 文件系统尚未挂载，将在 systemd mount namespace 内尝试挂载\n' ;;
    esac
    if cgroup_has_controller pids; then
        printf '[通过] pids controller\n'
    else
        printf '[缺失] pids controller\n' >&2
        return 1
    fi
}

namespace_check() {
    local option=$1 label=$2
    if unshare "$option" --fork /bin/true >/dev/null 2>&1; then
        printf '[通过] namespace: %s\n' "$label"
        return 0
    fi
    printf '[缺失] namespace: %s\n' "$label" >&2
    return 1
}

systemd_pid_files() {
    PID_FILE="$CONTAINER/.xtmoe-systemd.pid"
    LAUNCHER_PID_FILE="$CONTAINER/.xtmoe-systemd-launcher.pid"
    SYSTEMD_LOG_FILE="$CONTAINER/.xtmoe-systemd.log"
}

direct_docker_pid_files() {
    DIRECT_DOCKER_PID_FILE="$CONTAINER/.xtmoe-dockerd.pid"
    DIRECT_DOCKER_LAUNCHER_PID_FILE="$CONTAINER/.xtmoe-dockerd-launcher.pid"
    DIRECT_DOCKER_LOG_FILE="$ROOTFS/var/log/dockerd.log"
}

process_alive() {
    local value=$1
    [[ $value =~ ^[0-9]+$ ]] && kill -0 "$value" 2>/dev/null
}

find_child_pid() {
    local parent=$1 expected_comm=${2:-systemd} proc ppid child comm actual_root expected_root
    local -a candidates=()
    expected_root=$(realpath -m "$ROOTFS")
    if [[ -r /proc/$parent/task/$parent/children ]]; then
        read -r -a candidates <"/proc/$parent/task/$parent/children" || true
    else
        for proc in /proc/[0-9]*; do
            [[ -r $proc/status ]] || continue
            ppid=$(awk '$1 == "PPid:" { print $2 }' "$proc/status")
            [[ $ppid == "$parent" ]] && candidates+=("${proc##*/}")
        done
    fi
    for child in "${candidates[@]}"; do
        [[ $child =~ ^[0-9]+$ ]] || continue
        actual_root=$(realpath -m "/proc/$child/root")
        [[ $actual_root == "$expected_root" ]] || continue
        comm=$(cat "/proc/$child/comm" 2>/dev/null || true)
        [[ $comm == "$expected_comm" || $expected_comm == systemd && $comm == init ]] || continue
        printf '%s\n' "$child"
        return 0
    done
    return 1
}

find_direct_docker_pid() { find_child_pid "$1" dockerd; }

systemd_running() {
    local pid comm actual_root expected_root
    systemd_pid_files
    [[ -r $PID_FILE ]] || return 1
    IFS= read -r pid <"$PID_FILE"
    process_alive "$pid" || return 1
    actual_root=$(realpath -m "/proc/$pid/root")
    expected_root=$(realpath -m "$ROOTFS")
    [[ $actual_root == "$expected_root" ]] || return 1
    comm=$(cat "/proc/$pid/comm" 2>/dev/null || true)
    [[ $comm == systemd || $comm == init ]]
}

systemd_manager_ready() {
    local pid
    systemd_pid_files
    [[ -r $PID_FILE ]] || return 1
    IFS= read -r pid <"$PID_FILE"
    process_alive "$pid" || return 1
    [[ -S /proc/$pid/root/run/systemd/private && -d /proc/$pid/root/run/systemd/system ]]
}

systemd_target_pid() {
    local pid comm actual_root expected_root
    systemd_pid_files
    [[ -r $PID_FILE ]] || die '嵌套 systemd 未启动'
    IFS= read -r pid <"$PID_FILE"
    process_alive "$pid" || die '嵌套 systemd 进程已退出'
    actual_root=$(realpath -m "/proc/$pid/root")
    expected_root=$(realpath -m "$ROOTFS")
    [[ $actual_root == "$expected_root" ]] || die 'systemd PID 与当前容器不匹配'
    comm=$(cat "/proc/$pid/comm" 2>/dev/null || true)
    [[ $comm == systemd || $comm == init ]] || die "systemd PID 进程类型不匹配：$comm"
    printf '%s\n' "$pid"
}

direct_docker_running() {
    local pid comm actual_root expected_root
    direct_docker_pid_files
    [[ -r $DIRECT_DOCKER_PID_FILE ]] || return 1
    IFS= read -r pid <"$DIRECT_DOCKER_PID_FILE"
    process_alive "$pid" || return 1
    actual_root=$(realpath -m "/proc/$pid/root")
    expected_root=$(realpath -m "$ROOTFS")
    [[ $actual_root == "$expected_root" ]] || return 1
    comm=$(cat "/proc/$pid/comm" 2>/dev/null || true)
    [[ $comm == dockerd ]]
}

direct_docker_target_pid() {
    local pid
    direct_docker_running || die '直接启动的 dockerd 未运行'
    IFS= read -r pid <"$DIRECT_DOCKER_PID_FILE"
    printf '%s\n' "$pid"
}

systemd_check() {
    local failures=0 controllers
    [[ -f $CONTAINER/.xtmoe-chroot ]] || die '容器标记不存在'
    if command -v unshare >/dev/null 2>&1; then
        systemd_check_pass 'unshare 命令'
    else
        systemd_check_fail 'unshare 命令'; ((failures += 1))
    fi
    if command -v nsenter >/dev/null 2>&1; then
        systemd_check_pass 'nsenter 命令'
    else
        systemd_check_fail 'nsenter 命令'; ((failures += 1))
    fi
    if [[ -x $ROOTFS/usr/bin/systemctl ]]; then
        systemd_check_pass '容器内 systemctl'
    else
        systemd_check_fail '容器内 systemctl（安装 systemd-sysv）'; ((failures += 1))
    fi
    if rootfs_has_shell "$ROOTFS"; then
        systemd_check_pass 'rootfs /bin/sh'
    else
        systemd_check_fail 'rootfs /bin/sh'; ((failures += 1))
    fi
    if rootfs_has_systemd_init "$ROOTFS"; then
        systemd_check_pass 'systemd init'
    else
        systemd_check_fail '/sbin/init 未指向可执行 systemd'; ((failures += 1))
    fi
    if unshare --mount --pid --fork /bin/true >/dev/null 2>&1; then
        systemd_check_pass 'PID/Mount namespace'
    else
        systemd_check_fail 'PID/Mount namespace'; ((failures += 1))
    fi
    if grep -qw cgroup2 /proc/filesystems && [[ -w /sys/fs/cgroup ]]; then
        systemd_check_pass '可写 cgroup2'
    elif grep -qw cgroup /proc/filesystems && [[ -w /sys/fs/cgroup ]]; then
        systemd_check_note '使用 cgroup v1；systemd 兼容性取决于挂载的 controllers'
    elif grep -Eqw 'cgroup|cgroup2' /proc/filesystems; then
        systemd_check_note 'cgroup 未挂载或不可写；将为 Chroot 尝试独立挂载，Docker 仍需严格检查'
    else
        systemd_check_fail '可写 cgroup/cgroup2'; ((failures += 1))
    fi
    controllers=$(cat /sys/fs/cgroup/cgroup.controllers 2>/dev/null || true)
    if grep -qw pids /proc/cgroups 2>/dev/null || printf '%s\n' "$controllers" | grep -qw pids; then
        systemd_check_pass 'pids cgroup controller'
    else
        systemd_check_note '缺少 pids cgroup controller；systemd 可能降级，Docker/1Panel 很可能不可用'
    fi
    if ((failures)); then
        printf 'systemd 前置检查失败：%d 个阻断项\n' "$failures" >&2
        return 1
    fi
    printf 'systemd 前置检查通过；可尝试嵌套启动\n'
}

docker_network_probe_script() {
    cat <<'NETWORK_PROBE'
set -Eeuo pipefail
ipv4=$1
ipv6=${2:-}
"$ipv4" -w 2 -t nat -N XTMOE_PROBE
"$ipv4" -w 2 -t nat -A PREROUTING -m addrtype --dst-type LOCAL -j XTMOE_PROBE
"$ipv4" -w 2 -t nat -A XTMOE_PROBE -p tcp --dport 65530 -j DNAT --to-destination 192.0.2.2:80
"$ipv4" -w 2 -t nat -A POSTROUTING -s 192.0.2.0/24 -j MASQUERADE
"$ipv4" -w 2 -A FORWARD -m conntrack --ctstate RELATED,ESTABLISHED -j ACCEPT
ip link add xtmoeprobe0 type bridge
ip link add xtmoeveth0 type veth peer name xtmoeveth1
ip link set xtmoeveth0 master xtmoeprobe0
if [[ -n $ipv6 ]]; then
    "$ipv6" -w 2 -t nat -N XTMOE_PROBE
    "$ipv6" -w 2 -t nat -A PREROUTING -m addrtype --dst-type LOCAL -j XTMOE_PROBE
    "$ipv6" -w 2 -t nat -A POSTROUTING -s 2001:db8::/64 -j MASQUERADE
fi
NETWORK_PROBE
}

docker_network_probe() {
    local ipv4=$1 ipv6=${2:-}
    timeout --kill-after=2 20 unshare --net chroot "$ROOTFS" /usr/bin/env -i \
        HOME=/root USER=root LOGNAME=root LANG=C.UTF-8 \
        PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
        /bin/bash -c "$(docker_network_probe_script)" _ "$ipv4" "$ipv6"
}

# A non-login guest shell must not inherit Android's executable search paths.
docker_guest_exec() {
    chroot "$ROOTFS" /usr/bin/env -i \
        HOME=/root USER=root LOGNAME=root LANG=C.UTF-8 \
        PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin "$@"
}

# Called by installation after displaying its host-network scope.
# docker-check remains diagnostic: it does not select a different backend.
docker_network_prepare() {
    local output ipv6='' previous mode
    rootfs_has_executable "$ROOTFS" /usr/sbin/ip6tables && ipv6=/usr/sbin/ip6tables
    if output=$(docker_network_probe /usr/sbin/iptables "$ipv6" 2>&1); then
        ok '当前 iptables 后端的真实 NAT/bridge 规则测试通过'
        return 0
    fi
    printf '%s\n' "$output" >&2
    rootfs_has_executable "$ROOTFS" /usr/sbin/iptables-legacy || return 2
    ipv6=''
    rootfs_has_executable "$ROOTFS" /usr/sbin/ip6tables-legacy && ipv6=/usr/sbin/ip6tables-legacy
    if ! output=$(docker_network_probe /usr/sbin/iptables-legacy "$ipv6" 2>&1); then
        printf '%s\n' "$output" >&2
        warn '当前后端和 legacy 均未通过真实网络规则测试；不安装 Docker'
        return 2
    fi
    previous=$(docker_guest_exec /usr/bin/readlink -f /usr/sbin/iptables) || return 1
    mode=$(docker_guest_exec /usr/bin/update-alternatives --query iptables | awk '$1 == "Status:" {print $2}') || return 1
    docker_guest_exec /bin/bash -ec '
umask 077
install -d /var/lib/xtmoe
backup=$(mktemp -d /var/lib/xtmoe/iptables-backup.XXXXXX)
update-alternatives --query iptables >"$backup/iptables"
if update-alternatives --query ip6tables >"$backup/ip6tables"; then :; else rm -f "$backup/ip6tables"; fi
printf "iptables alternatives backup: %s\n" "$backup"
' || return 1
    docker_guest_exec /usr/bin/update-alternatives --set iptables /usr/sbin/iptables-legacy || return 1
    if [[ -n $ipv6 ]] && ! docker_guest_exec /usr/bin/update-alternatives --set ip6tables "$ipv6"; then
        if [[ $mode == auto ]]; then
            docker_guest_exec /usr/bin/update-alternatives --auto iptables || true
        else
            docker_guest_exec /usr/bin/update-alternatives --set iptables "$previous" || true
        fi
        return 1
    fi
    ok '当前后端不兼容，已在测试通过并备份后选择 legacy；未清空宿主防火墙'
}

docker_storage_prepare() {
    local config="$ROOTFS/etc/docker/daemon.json" probe result=0 tmp
    [[ ! -L $config ]] || { warn 'daemon.json 为符号链接，拒绝自动修改'; return 1; }
    if [[ -e $config ]]; then
        [[ -f $config ]] || return 1
        ok '保留已有 daemon.json；实际存储能力仍需真实容器验收'
        return 0
    fi
    # Switching image stores hides existing images/containers. Never do that
    # automatically for an existing data directory, even if JSON is absent.
    for probe in "$ROOTFS/var/lib/docker" "$ROOTFS/var/lib/containerd"; do
        if [[ -d $probe && -n $(ls -A -- "$probe") ]]; then
            warn '已有 Docker/containerd 数据，不自动切换存储后端；保留数据等待实际验收'
            return 0
        fi
    done
    mkdir -p "$ROOTFS/var/lib"
    probe=$(mktemp -d "$ROOTFS/var/lib/.xtmoe-overlay-probe.XXXXXX") || return 1
    mkdir -p "$probe"/{lower,upper,work,merged}
    printf probe >"$probe/lower/test"
    timeout --kill-after=2 20 unshare --mount --fork --kill-child "$TERMUX_PREFIX/bin/bash" -ec '
mount --make-rprivate /
mount -t overlay overlay -o "lowerdir=$1/lower,upperdir=$1/upper,workdir=$1/work,index=off" "$1/merged"
test "$(cat "$1/merged/test")" = probe
umount "$1/merged"
' _ "$probe" || result=$?
    rm -rf --one-file-system -- "$probe"
    ((result != 0)) || { ok '目标数据文件系统上的 OverlayFS 实际挂载测试通过'; return 0; }
    mkdir -p "$ROOTFS/etc/docker"
    tmp=$(mktemp "$ROOTFS/etc/docker/.daemon.xtmoe.XXXXXX") || return 1
    printf '%s\n' '{"features":{"containerd-snapshotter":false},"storage-driver":"vfs"}' >"$tmp"
    chmod 0644 "$tmp"
    # Hard-link creation is exclusive: a concurrent user config is not replaced.
    if ! ln -- "$tmp" "$config"; then rm -f -- "$tmp"; return 1; fi
    rm -f -- "$tmp"
    warn 'OverlayFS 在目标文件系统上不可用；全新配置使用经典 VFS（较慢且占空间），已关闭 containerd snapshotter'
}

docker_gate() {
    local failures=0 kernel_failures=0 mode ip_forward iptables_path='' ipv6='' output scope=${1:-full}
    printf 'Kernel: %s\nArchitecture: %s\n' "$(uname -r)" "$(uname -m)"
    namespace_check --mount mount || ((failures += 1))
    namespace_check --pid pid || ((failures += 1))
    namespace_check --net network || ((failures += 1))
    namespace_check --ipc ipc || ((failures += 1))
    namespace_check --uts uts || ((failures += 1))
    [[ -e /proc/self/ns/user ]] && printf '[通过] namespace: user（可选）\n' || printf '[警告] namespace: user 不存在（rootful Docker 可选）\n'

    mode=$(cgroup_mode)
    case "$mode" in
        v1|v2) printf '[通过] cgroup hierarchy: %s\n' "$mode" ;;
        v1-unmounted|v2-unmounted) printf '[缺失] cgroup hierarchy 未挂载\n' >&2; ((failures += 1)) ;;
        *) printf '[缺失] cgroup hierarchy\n' >&2; ((failures += 1)) ;;
    esac
    if cgroup_has_controller pids && { [[ $mode != v1 ]] || cgroup_v1_controller_mounted pids; }; then
        printf '[通过] pids cgroup controller\n'
    else
        printf '[缺失] pids cgroup controller\n' >&2
        ((failures += 1))
    fi
    if [[ $mode == v1 ]]; then
        if cgroup_has_controller devices && cgroup_v1_controller_mounted devices; then
            printf '[通过] devices cgroup v1 controller\n'
        else
            printf '[缺失] devices cgroup v1 controller\n' >&2
            ((failures += 1))
        fi
    elif [[ $mode == v2 ]]; then
        printf '[警告] cgroup v2 devices 由 BPF/runc 实测确认\n'
    fi

    grep -qw overlay /proc/filesystems && printf '[通过] OverlayFS\n' || printf '[警告] OverlayFS 缺失，将尝试 vfs 存储驱动\n'
    ip_forward=$(cat /proc/sys/net/ipv4/ip_forward 2>/dev/null || printf 0)
    if [[ $ip_forward == 1 ]]; then
        printf '[通过] IPv4 forwarding\n'
    elif [[ -w /proc/sys/net/ipv4/ip_forward ]]; then
        printf '[警告] IPv4 forwarding 未启用，但当前可写；dockerd 可能启用它\n'
    else
        printf '[缺失] IPv4 forwarding 未启用且不可写\n' >&2
        ((failures += 1))
    fi
    kernel_failures=$failures
    if [[ $scope == kernel ]]; then
        printf 'Summary: kernel_or_permission=%s（尚未验证 iptables/systemd/Docker 运行）\n' "$kernel_failures"
        ((kernel_failures == 0)) || return 2
        return 0
    fi
    if rootfs_has_executable "$ROOTFS" /usr/sbin/iptables; then
        iptables_path=/usr/sbin/iptables
    elif rootfs_has_executable "$ROOTFS" /usr/bin/iptables; then
        iptables_path=/usr/bin/iptables
    fi
    if [[ -n $iptables_path ]] && output=$(timeout 10 chroot "$ROOTFS" "$iptables_path" --version 2>&1); then
        printf '[通过] 容器内 iptables: %s\n' "$output"
        rootfs_has_executable "$ROOTFS" /usr/sbin/ip6tables && ipv6=/usr/sbin/ip6tables
        # A list-only query passes on kernels that cannot create Docker's
        # addrtype/NAT rules. All temporary writes stay inside a fresh netns.
        if output=$(docker_network_probe "$iptables_path" "$ipv6" 2>&1); then
            printf '[通过] 独立 network namespace 中的真实 NAT/addrtype/bridge/veth 操作\n'
        else
            printf '[缺失] iptables NAT/内核权限检查失败（未修改宿主规则）：%s\n' "$output" >&2
            ((failures += 1)); ((kernel_failures += 1))
        fi
    else
        printf '[缺失] 容器内 iptables 不存在或不可执行；请运行 chroot init/setup 安装用户态依赖\n' >&2
        ((failures += 1))
    fi
    if systemd_running && systemd_manager_ready; then
        printf '[通过] 嵌套 systemd manager\n'
    else
        printf '[缺失] 嵌套 systemd manager\n' >&2
        ((failures += 1))
    fi
    printf 'Summary: failures=%s kernel_or_permission=%s software_or_service=%s\n' "$failures" "$kernel_failures" "$((failures - kernel_failures))"
    ((kernel_failures == 0)) || return 2
    ((failures == 0))
}

ensure_cgroup_mount() {
    local target="$ROOTFS/sys/fs/cgroup" mode controller hierarchy
    mkdir -p "$target"
    mode=$(cgroup_mode)
    if [[ $mode == v2 && -e /proc/1/ns/cgroup && -e /proc/self/ns/cgroup &&
        $(readlink /proc/1/ns/cgroup) != "$(readlink /proc/self/ns/cgroup)" ]]; then
        umount "$target" 2>/dev/null || true
        if mount -t cgroup2 -o nosuid,nodev,noexec cgroup2 "$target" 2>/dev/null; then
            ok "已在独立 cgroup namespace 重新挂载 cgroup2：$target"
            return 0
        fi
    fi
    if is_mounted "$target"; then
        ok "cgroup 已挂载：$target"
        return 0
    fi
    case "$mode" in
        v2|v2-unmounted)
            mount -t cgroup2 -o nosuid,nodev,noexec cgroup2 "$target" || {
                warn '无法在 Chroot 挂载 cgroup2；systemd 将使用宿主兼容视图'
                return 0
            }
            ;;
        v1|v1-unmounted)
            mount -t tmpfs -o mode=755,nosuid,nodev,noexec cgroup_root "$target" || return 0
            while read -r controller hierarchy; do
                [[ $hierarchy != 0 ]] || continue
                mkdir -p "$target/$controller"
                mount -t cgroup -o "$controller" cgroup "$target/$controller" 2>/dev/null ||
                    warn "无法挂载 cgroup v1 controller：$controller"
            done < <(awk 'NR > 1 && $4 == 1 { print $1, $2 }' /proc/cgroups)
            ;;
        *) warn '内核没有可挂载的 cgroup 文件系统' ;;
    esac
}

# This is called only after entering the private mount namespace. A bind
# remount changes this mount's VFS flags, not Android's sysfs superblock.
systemd_protect_kernel_views() {
    local sys_root="$ROOTFS/sys" encoded mounts target found_root=0
    [[ -d $sys_root && ! -L $sys_root ]] || die '无效 /sys，拒绝启动 systemd'
    encoded=$(mount_path_encode "$sys_root")
    mounts=$(awk -v p="$encoded" '$2 == p || index($2, p "/") == 1 { print $2 }' /proc/self/mounts |
        awk '{ print length, $0 }' | sort -rn | cut -d' ' -f2-)
    [[ -n $mounts ]] || die '容器 /sys 未挂载，拒绝启动 systemd'
    while IFS= read -r target; do
        target=$(mount_path_decode "$target")
        case "$target" in "$sys_root/fs/cgroup"|"$sys_root/fs/cgroup/"*) continue ;; esac
        [[ $target != "$sys_root" ]] || found_root=1
        mount -o remount,bind,ro -- "$target" || die "无法将容器内核接口设为只读：$target"
    done <<<"$mounts"
    ((found_root)) || die '缺少容器 /sys 根挂载'
    # Older images may expose a second SELinux mount at /selinux.
    if [[ -d $ROOTFS/selinux ]]; then
        [[ ! -L $ROOTFS/selinux ]] || die '/selinux 不能是符号链接'
        mount --bind "$ROOTFS/selinux" "$ROOTFS/selinux" || die '无法隔离容器 /selinux'
        mount -o remount,bind,ro -- "$ROOTFS/selinux" || die '无法保护容器 /selinux'
    fi
    ok '容器 /sys 及其非 cgroup 子挂载已设为只读；不修改宿主 SELinux 模式或 policy'
}

systemd_guest_init_script() {
    cat <<'GUEST_INIT'
set -Eeuo pipefail
# procfs must describe the new PID namespace. Silently using Android's procfs
# here can confuse both systemd's chroot and container detection.
mount -t proc proc /proc || { printf '无法挂载容器 PID namespace 的 /proc\n' >&2; exit 1; }
[[ $$ == 1 ]] || { printf '拒绝启动：systemd 启动 Shell 不是容器 PID 1\n' >&2; exit 1; }
[[ ${container:-} == xtmoe ]] || { printf '缺少 XTMOE 容器环境标识\n' >&2; exit 1; }
install -d -m 0755 /run/host
printf 'xtmoe\n' >/run/host/container-manager
exec /sbin/init --unit=multi-user.target
GUEST_INIT
}

systemd_namespace_launch() {
    local config=${1:-}
    [[ $(readlink /proc/self/ns/mnt) != "$(readlink /proc/1/ns/mnt)" ]] || die '拒绝在宿主 mount namespace 内启动 systemd'
    mount --make-rprivate / || die '无法隔离 mount namespace 的挂载传播'
    mount_all "$config" 0 || die '准备 systemd 挂载失败'
    ensure_cgroup_mount || die '准备 systemd cgroup 失败'
    systemd_protect_kernel_views || die '保护宿主内核接口失败'
    exec chroot "$ROOTFS" /usr/bin/env -i \
        HOME=/root USER=root LOGNAME=root TERM="${TERM:-xterm-256color}" \
        PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
        LANG=C.UTF-8 container=xtmoe \
        /bin/bash -c "$(systemd_guest_init_script)"
}

systemd_start() {
    local config=${1:-} launcher_pid target_pid attempt helper_path
    local extra
    local -a namespace_args=(--mount --pid) candidate_args
    direct_docker_running && die 'direct dockerd 正在运行；请先执行 xtmoe chroot stop 再启动 systemd。'
    systemd_check
    systemd_pid_files
    if systemd_running; then
        systemd_manager_ready && { ok '嵌套 systemd 已在运行并就绪'; return 0; }
        die '嵌套 systemd 进程存在，但 manager 尚未就绪'
    fi
    is_mounted "$ROOTFS" && die '容器已有普通 Chroot 挂载；请先退出会话并执行 stop。'
    rm -f -- "$PID_FILE" "$LAUNCHER_PID_FILE"
    for extra in --ipc --uts --cgroup; do
        candidate_args=("${namespace_args[@]}" "$extra")
        if unshare "${candidate_args[@]}" --fork /bin/true >/dev/null 2>&1; then
            namespace_args=("${candidate_args[@]}")
        fi
    done
    helper_path=$(realpath -m -- "${BASH_SOURCE[0]}")
    [[ ! -L $SYSTEMD_LOG_FILE && ( ! -e $SYSTEMD_LOG_FILE || -f $SYSTEMD_LOG_FILE ) ]] || die '不安全的 systemd 日志路径'
    printf '\n[XTMOE %s] systemd start; container=xtmoe; namespaces=%s; host-selinux-enforce=%s\n' \
        "$(date -Iseconds)" "${namespace_args[*]}" "$(cat /sys/fs/selinux/enforce 2>/dev/null || printf unavailable)" >>"$SYSTEMD_LOG_FILE"
    nohup unshare "${namespace_args[@]}" --fork --kill-child \
        "$TERMUX_PREFIX/bin/bash" "$helper_path" "$TERMUX_PREFIX" "${PROXY_HELPER_ARGS[@]}" \
        _systemd-launch "$BASE" "$CONTAINER_NAME" "$config" \
        </dev/null >>"$SYSTEMD_LOG_FILE" 2>&1 &
    launcher_pid=$!
    printf '%s\n' "$launcher_pid" >"$LAUNCHER_PID_FILE"
    target_pid=''
    for ((attempt = 0; attempt < 50; attempt++)); do
        target_pid=$(find_child_pid "$launcher_pid" || true)
        [[ -n $target_pid ]] && break
        sleep 0.1
    done
    if [[ -z $target_pid ]]; then
        kill -TERM "$launcher_pid" 2>/dev/null || true
        die "无法定位嵌套 systemd 进程；查看 $SYSTEMD_LOG_FILE"
    fi
    printf '%s\n' "$target_pid" >"$PID_FILE"
    for ((attempt = 0; attempt < 300; attempt++)); do
        systemd_manager_ready && break
        process_alive "$target_pid" || break
        sleep 0.1
    done
    if ! process_alive "$target_pid"; then
        rm -f -- "$PID_FILE" "$LAUNCHER_PID_FILE"
        die "systemd 已退出；查看 $SYSTEMD_LOG_FILE"
    fi
    if ! systemd_manager_ready; then
        kill -TERM "$target_pid" 2>/dev/null || true
        kill -TERM "$launcher_pid" 2>/dev/null || true
        sleep 1
        process_alive "$target_pid" && kill -KILL "$target_pid" 2>/dev/null || true
        rm -f -- "$PID_FILE" "$LAUNCHER_PID_FILE"
        die "systemd manager 未就绪；查看 $SYSTEMD_LOG_FILE"
    fi
    ok "嵌套 systemd 已启动并就绪（宿主 PID $target_pid）"
}

systemd_exec() {
    local pid
    local -a nsenter_args
    (($#)) || die '缺少要在 systemd 容器内执行的命令'
    pid=$(systemd_target_pid)
    nsenter_args=(--target "$pid" --pid --mount)
    [[ -e /proc/$pid/ns/ipc ]] && nsenter_args+=(--ipc)
    [[ -e /proc/$pid/ns/uts ]] && nsenter_args+=(--uts)
    if [[ -e /proc/$pid/ns/cgroup ]] && nsenter --help 2>&1 | grep -q -- '--cgroup'; then
        nsenter_args+=(--cgroup)
    fi
    nsenter "${nsenter_args[@]}" -- \
        chroot "$ROOTFS" /usr/bin/env -i \
        HOME=/root USER=root LOGNAME=root TERM="${TERM:-xterm-256color}" \
        PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
        LANG=C.UTF-8 "${GUEST_PROXY_ENV[@]}" "$@"
}

guest_interactive_login() {
    local executor=$1
    # Allocate the controlling PTY AFTER entering the PID namespace. Reusing
    # Android's terminal leaves its foreground pgrp outside the guest PID view.
    if [[ -t 0 && -t 1 ]]; then
        rootfs_has_executable "$ROOTFS" /usr/bin/script || die '交互登录缺少 Ubuntu util-linux script；请执行 xtmoe chroot setup'
        "$executor" /usr/bin/script -q -e -c 'exec /bin/bash -l' /dev/null
    else
        "$executor" /bin/bash -l
    fi
}

systemd_login() {
    guest_interactive_login systemd_exec
}

systemd_status() {
    local pid
    pid=$(systemd_target_pid)
    printf 'running pid=%s\n' "$pid"
    systemd_exec /usr/bin/systemctl is-system-running || true
}

systemd_stop() {
    local pid attempt
    if ! systemd_running; then
        systemd_pid_files
        rm -f -- "$PID_FILE" "$LAUNCHER_PID_FILE"
        if is_mounted "$ROOTFS"; then
            unmount_all "$ROOTFS" || { warn '部分挂载仍被占用，停止未完成'; return 1; }
        fi
        ok '嵌套 systemd 未运行'
        return 0
    fi
    pid=$(systemd_target_pid)
    if rootfs_has_executable "$ROOTFS" /usr/bin/docker; then
        systemd_exec /usr/bin/systemctl stop docker.service docker.socket containerd.service >/dev/null 2>&1 || true
    fi
    systemd_exec /usr/bin/systemctl poweroff >/dev/null 2>&1 || kill -TERM "$pid" 2>/dev/null || true
    for ((attempt = 0; attempt < 100; attempt++)); do
        process_alive "$pid" || break
        sleep 0.1
    done
    if process_alive "$pid"; then
        warn 'systemd 仍在运行；请检查会话内后台服务'
        return 1
    fi
    systemd_pid_files
    rm -f -- "$PID_FILE" "$LAUNCHER_PID_FILE"
    unmount_all "$ROOTFS" || { warn 'systemd 已停止，但部分挂载未卸载'; return 1; }
    ok '嵌套 systemd 已停止'
}

direct_docker_namespace_launch() {
    local config=${1:-}
    mount --make-rprivate / || die '无法隔离 mount namespace 的挂载传播'
    mount_all "$config"
    mkdir -p "$ROOTFS/var/log"
    exec chroot "$ROOTFS" /usr/bin/env -i \
        HOME=/root USER=root LOGNAME=root TERM="${TERM:-xterm-256color}" \
        PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
        LANG=C.UTF-8 "${GUEST_PROXY_ENV[@]}" /usr/bin/dockerd --iptables=true --host=unix:///var/run/docker.sock
}

direct_docker_start() {
    local config=${1:-} launcher_pid target_pid attempt helper_path
    [[ -x $ROOTFS/usr/bin/dockerd ]] || die '容器内未安装 dockerd；请先执行 docker-direct-install'
    systemd_running && die '嵌套 systemd 正在运行；直接 dockerd 模式不能与 systemd 模式并存，请先执行 xtmoe chroot stop'
    direct_docker_pid_files
    if direct_docker_running; then
        direct_docker_exec /usr/bin/timeout --kill-after=2 15 /usr/bin/docker info >/dev/null 2>&1 || die '已有 dockerd 进程但 API 不可响应；请查看 docker-direct-logs。'
        ok '直接 dockerd 已在运行且 API 可响应'
        return 0
    fi
    is_mounted "$ROOTFS" && die '容器已有普通 Chroot 挂载；请先退出会话并执行 stop。'
    command -v unshare >/dev/null 2>&1 || die '缺少 unshare；请执行 xtmoe chroot prepare'
    mkdir -p "$(dirname -- "$DIRECT_DOCKER_LOG_FILE")"
    rm -f -- "$DIRECT_DOCKER_PID_FILE" "$DIRECT_DOCKER_LAUNCHER_PID_FILE"
    helper_path=$(realpath -m -- "${BASH_SOURCE[0]}")
    ok '正在启动 direct dockerd（等待进程，最长约 5 秒）'
    nohup unshare --mount --pid --fork --kill-child \
        "$TERMUX_PREFIX/bin/bash" "$helper_path" "$TERMUX_PREFIX" "${PROXY_HELPER_ARGS[@]}" \
        _docker-direct-launch "$BASE" "$CONTAINER_NAME" "$config" \
        >"$DIRECT_DOCKER_LOG_FILE" 2>&1 &
    launcher_pid=$!
    printf '%s\n' "$launcher_pid" >"$DIRECT_DOCKER_LAUNCHER_PID_FILE"
    target_pid=''
    for ((attempt = 0; attempt < 50; attempt++)); do
        target_pid=$(find_direct_docker_pid "$launcher_pid" || true)
        [[ -n $target_pid ]] && break
        sleep 0.1
    done
    if [[ -z $target_pid ]]; then
        kill -TERM "$launcher_pid" 2>/dev/null || true
        die "无法定位直接启动的 dockerd；查看 $DIRECT_DOCKER_LOG_FILE"
    fi
    printf '%s\n' "$target_pid" >"$DIRECT_DOCKER_PID_FILE"
    ok 'dockerd 进程已找到；正在等待 Docker socket（最长约 15 秒）'
    for ((attempt = 0; attempt < 150; attempt++)); do
        [[ -S /proc/$target_pid/root/var/run/docker.sock ]] && break
        process_alive "$target_pid" || break
        sleep 0.1
    done
    process_alive "$target_pid" || { rm -f -- "$DIRECT_DOCKER_PID_FILE" "$DIRECT_DOCKER_LAUNCHER_PID_FILE"; die "dockerd 已退出；查看 $DIRECT_DOCKER_LOG_FILE"; }
    if [[ ! -S /proc/$target_pid/root/var/run/docker.sock ]]; then
        die "dockerd 未在 15 秒内创建 socket；查看 $DIRECT_DOCKER_LOG_FILE"
    fi
    ok 'Docker socket 已创建；正在验证 docker info（最长约 15 秒）'
    if ! direct_docker_exec /usr/bin/timeout 15 /usr/bin/docker info >/dev/null 2>&1; then
        die "dockerd API 在 15 秒内不可用；查看 $DIRECT_DOCKER_LOG_FILE"
    fi
    ok "直接 dockerd 已启动并可响应（宿主 PID $target_pid）"
}

direct_docker_exec() {
    local pid
    (($#)) || die '缺少要在直接 dockerd 容器内执行的命令'
    pid=$(direct_docker_target_pid)
    nsenter --target "$pid" --mount --pid -- \
        chroot "$ROOTFS" /usr/bin/env -i \
        HOME=/root USER=root LOGNAME=root TERM="${TERM:-xterm-256color}" \
        PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
        LANG=C.UTF-8 "${GUEST_PROXY_ENV[@]}" "$@"
}

direct_docker_status() {
    local pid
    pid=$(direct_docker_target_pid)
    printf 'direct running pid=%s\n' "$pid"
    direct_docker_exec /usr/bin/timeout 15 /usr/bin/docker info
}

direct_docker_stop() {
    local pid attempt
    if ! direct_docker_running; then
        direct_docker_pid_files
        rm -f -- "$DIRECT_DOCKER_PID_FILE" "$DIRECT_DOCKER_LAUNCHER_PID_FILE"
        ok '直接 dockerd 未运行'
        return 0
    fi
    pid=$(direct_docker_target_pid)
    kill -TERM "$pid" 2>/dev/null || true
    for ((attempt = 0; attempt < 100; attempt++)); do
        process_alive "$pid" || break
        sleep 0.1
    done
    process_alive "$pid" && { warn 'dockerd 仍在运行；请查看日志和容器任务'; return 1; }
    direct_docker_pid_files
    rm -f -- "$DIRECT_DOCKER_PID_FILE" "$DIRECT_DOCKER_LAUNCHER_PID_FILE"
    ok '直接 dockerd 已停止'
}

direct_docker_logs() {
    direct_docker_pid_files
    [[ -r $DIRECT_DOCKER_LOG_FILE ]] || die "dockerd 日志不存在：$DIRECT_DOCKER_LOG_FILE"
    tail -n 200 -- "$DIRECT_DOCKER_LOG_FILE"
}

direct_docker_run_test() {
    direct_docker_exec /usr/bin/timeout --kill-after=2 180 /usr/bin/docker run --rm hello-world
}

docker_state() {
    if ! rootfs_has_executable "$ROOTFS" /usr/bin/docker; then
        printf 'not-installed\n'
        return 0
    fi
    if direct_docker_running; then
        if direct_docker_exec /usr/bin/timeout 15 /usr/bin/docker info >/dev/null 2>&1; then
            printf 'direct-daemon-ready\n'
        else
            printf 'direct-unresponsive\n'
        fi
        return 0
    fi
    if ! systemd_running; then
        printf 'installed-stopped\n'
        return 0
    fi
    if systemd_exec /usr/bin/timeout --kill-after=2 15 /usr/bin/docker info >/dev/null 2>&1; then
        printf 'daemon-ready\n'
    elif [[ -S /proc/$(systemd_target_pid)/root/run/docker.sock ]]; then
        printf 'unresponsive\n'
    else
        printf 'inactive\n'
    fi
}

install_rootfs() {
    local archive=$1 partial_rootfs dns
    shift
    [[ -f $archive ]] || die "镜像不存在：$archive"
    [[ ! -e $CONTAINER ]] || die "容器已存在：$CONTAINER"
    partial_rootfs="$BASE/.${CONTAINER##*/}.partial.$$"
    [[ ! -e $partial_rootfs ]] || die "临时目录已存在：$partial_rootfs"
    mkdir -p "$partial_rootfs/rootfs"
    if ! tar --numeric-owner -xpf "$archive" -C "$partial_rootfs/rootfs"; then
        rm -rf --one-file-system -- "$partial_rootfs"
        die '镜像解压失败'
    fi
    rootfs_has_shell "$partial_rootfs/rootfs" || { rm -rf --one-file-system -- "$partial_rootfs"; die '镜像解压后缺少可执行的 /bin/sh'; }
    mkdir -p "$partial_rootfs/rootfs"/{dev,proc,sys,run,tmp,root}
    chmod 1777 "$partial_rootfs/rootfs/tmp"
    ln -snf ../proc/mounts "$partial_rootfs/rootfs/etc/mtab"
    printf 'localhost\n' >"$partial_rootfs/rootfs/etc/hostname"
    ensure_hosts_config "$partial_rootfs/rootfs"
    : >"$partial_rootfs/rootfs/etc/resolv.conf"
    for dns in "$@"; do
        [[ $dns =~ ^[0-9A-Fa-f:.]+$ ]] || { rm -rf --one-file-system -- "$partial_rootfs"; die "非法 DNS 地址：$dns"; }
        printf 'nameserver %s\n' "$dns" >>"$partial_rootfs/rootfs/etc/resolv.conf"
    done
    [[ -s $partial_rootfs/rootfs/etc/resolv.conf ]] || printf 'nameserver 1.1.1.1\nnameserver 8.8.8.8\n' >"$partial_rootfs/rootfs/etc/resolv.conf"
    printf 'xtmoe-chroot-format-1\n' >"$partial_rootfs/.xtmoe-chroot"
    [[ ! -e $CONTAINER && ! -L $CONTAINER ]] || die '目标在解压期间已存在，拒绝覆盖'
    mv -T -- "$partial_rootfs" "$CONTAINER"
}

run_chroot() {
    local config=$1 command_status=0 script_bin; shift
    ensure_hosts_config "$ROOTFS"
    is_mounted "$ROOTFS" && die '容器已经处于 mounted 状态；请勿并发登录，先执行 stop。'
    trap 'unmount_all "$ROOTFS" || warn "异常退出后仍有挂载，请执行 xtmoe chroot stop"' EXIT
    trap 'exit 143' TERM
    mount_all "$config"
    set +e
    if (($#)); then
        chroot "$ROOTFS" /usr/bin/env -i \
            HOME=/root USER=root LOGNAME=root TERM="${TERM:-xterm-256color}" \
            PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
            LANG=C.UTF-8 "${GUEST_PROXY_ENV[@]}" "$@"
    else
        script_bin="$TERMUX_PREFIX/bin/script"
        if [[ -t 0 && -t 1 && -x $script_bin ]]; then
            "$script_bin" -q -e /dev/null -- \
                chroot "$ROOTFS" /usr/bin/env -i \
                HOME=/root USER=root LOGNAME=root TERM="${TERM:-xterm-256color}" \
                PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
                LANG=C.UTF-8 "${GUEST_PROXY_ENV[@]}" /bin/bash -l
        else
            [[ -x $script_bin ]] || warn '缺少 util-linux script，交互式 Shell 可能没有作业控制；请执行 xtmoe chroot prepare'
            chroot "$ROOTFS" /usr/bin/env -i \
                HOME=/root USER=root LOGNAME=root TERM="${TERM:-xterm-256color}" \
                PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
                LANG=C.UTF-8 "${GUEST_PROXY_ENV[@]}" /bin/bash -l
        fi
    fi
    command_status=$?
    set -e
    trap - EXIT TERM
    if ! unmount_all "$ROOTFS"; then
        warn '容器命令已经退出，但部分挂载仍在使用；必须执行 xtmoe chroot stop'
        return 1
    fi
    return "$command_status"
}

backup_container() {
    local output=$1 owner_uid=$2 owner_gid=$3 canonical_output partial_output
    [[ -f $CONTAINER/.xtmoe-chroot ]] || die '容器标记不存在，拒绝备份'
    systemd_running && die '嵌套 systemd 仍在运行；请先执行 stop'
    direct_docker_running && die '直接 dockerd 仍在运行；请先执行 docker-direct-stop'
    is_mounted "$ROOTFS" && die '容器仍有挂载；请先执行 stop'
    canonical_output=$(realpath -m -- "$output")
    [[ $canonical_output != "$CONTAINER" && $canonical_output != "$CONTAINER"/* ]] || die '备份文件不能写入被备份的容器内部'
    [[ ! -e $output && ! -L $output ]] || die "备份文件已存在或链接无效，拒绝覆盖：$output"
    mkdir -p -- "$(dirname -- "$output")"
    partial_output="${output}.partial.$$"
    [[ ! -e $partial_output && ! -L $partial_output ]] || die "临时备份路径已被占用：$partial_output"
    if ! tar --numeric-owner -czpf "$partial_output" -C "$CONTAINER" .; then
        rm -f -- "$partial_output"
        die '创建备份失败'
    fi
    mv -- "$partial_output" "$output"
    chown "$owner_uid:$owner_gid" "$output" 2>/dev/null || true
}

restore_container() {
    local archive=$1 partial
    [[ -f $archive && ! -L $archive ]] || die "备份不存在或不是普通文件：$archive"
    [[ ! -e $CONTAINER ]] || die '目标容器已存在'
    if tar -tzf "$archive" | awk '$0 ~ /^\// || $0 ~ /(^|\/)\.\.($|\/)/ { bad=1 } END { exit bad ? 0 : 1 }'; then
        die '备份包含绝对路径或上级目录引用，拒绝恢复'
    fi
    partial="$BASE/.${CONTAINER##*/}.restore.$$"
    mkdir -p "$partial"
    if ! tar --numeric-owner -xzpf "$archive" -C "$partial"; then
        rm -rf --one-file-system -- "$partial"
        die '备份解压失败'
    fi
    valid_container_tree "$partial" || { rm -rf --one-file-system -- "$partial"; die '不是有效的 XTMOE Chroot 备份'; }
    mv -- "$partial" "$CONTAINER"
}

remove_container() {
    [[ -f $CONTAINER/.xtmoe-chroot ]] || die '容器标记不存在，拒绝删除'
    systemd_running && die '嵌套 systemd 仍在运行；请先执行 xtmoe chroot stop'
    direct_docker_running && die '直接 dockerd 仍在运行；请先执行 xtmoe chroot stop'
    is_mounted "$ROOTFS" && die '容器仍有挂载；请先执行 xtmoe chroot stop'
    rm -rf --one-file-system -- "$CONTAINER"
}

ACTION=${1:-}
shift || true
case "$ACTION" in
    _internal-path-codec)
        [[ ${XTMOE_INTERNAL_TEST:-0} == 1 ]] || die '内部测试操作不可用'
        encoded=$(mount_path_encode "${1:?缺少测试路径}")
        decoded=$(mount_path_decode "$encoded")
        printf '%s\n%s\n' "$encoded" "$decoded"
        ;;
    _internal-mount-source-check)
        [[ ${XTMOE_INTERNAL_TEST:-0} == 1 ]] || die '内部测试操作不可用'
        ROOTFS=/tmp/xtmoe-internal-test-rootfs
        mount_one "${1:?缺少测试挂载源}" /mnt/test rw
        ;;
    _internal-hosts-config)
        [[ ${XTMOE_INTERNAL_TEST:-0} == 1 ]] || die '内部测试操作不可用'
        ensure_hosts_config "${1:?缺少测试 rootfs}"
        ;;
    _internal-rootfs-shell-check)
        [[ ${XTMOE_INTERNAL_TEST:-0} == 1 ]] || die '内部测试操作不可用'
        rootfs_has_shell "${1:?缺少测试 rootfs}" || die '测试 rootfs 缺少可执行的 /bin/sh'
        ok 'rootfs shell check passed'
        ;;
    _systemd-launch)
        container_paths "${1:?缺少基础目录}" "${2:?缺少名称}"
        [[ -f $CONTAINER/.xtmoe-chroot ]] || die '容器不存在'
        systemd_namespace_launch "${3:-}"
        ;;
    _docker-direct-launch)
        container_paths "${1:?缺少基础目录}" "${2:?缺少名称}"
        [[ -f $CONTAINER/.xtmoe-chroot ]] || die '容器不存在'
        direct_docker_namespace_launch "${3:-}"
        ;;
    set-dns)
        container_paths "${1:?缺少基础目录}" "${2:?缺少名称}"
        shift 2
        (($#)) || die '缺少 DNS 地址'
        [[ -f $CONTAINER/.xtmoe-chroot ]] || die '容器不存在'
        set_dns_config "$ROOTFS" "$@"
        ;;
    cgroup-check)
        container_paths "${1:?缺少基础目录}" "${2:?缺少名称}"
        [[ -f $CONTAINER/.xtmoe-chroot ]] || die '容器不存在'
        cgroup_check
        ;;
    docker-check)
        container_paths "${1:?缺少基础目录}" "${2:?缺少名称}"
        [[ -f $CONTAINER/.xtmoe-chroot ]] || die '容器不存在'
        docker_gate
        ;;
    docker-kernel-check)
        container_paths "${1:?缺少基础目录}" "${2:?缺少名称}"
        [[ -f $CONTAINER/.xtmoe-chroot ]] || die '容器不存在'
        docker_gate kernel
        ;;
    docker-network-prepare)
        container_paths "${1:?缺少基础目录}" "${2:?缺少名称}"
        [[ -f $CONTAINER/.xtmoe-chroot ]] || die '容器不存在'
        docker_network_prepare
        ;;
    docker-storage-prepare)
        container_paths "${1:?缺少基础目录}" "${2:?缺少名称}"
        [[ -f $CONTAINER/.xtmoe-chroot ]] || die '容器不存在'
        docker_storage_prepare
        ;;
    docker-state)
        container_paths "${1:?缺少基础目录}" "${2:?缺少名称}"
        [[ -f $CONTAINER/.xtmoe-chroot ]] || die '容器不存在'
        docker_state
        ;;
    docker-direct-start)
        container_paths "${1:?缺少基础目录}" "${2:?缺少名称}"
        [[ -f $CONTAINER/.xtmoe-chroot ]] || die '容器不存在'
        direct_docker_start "${3:-}"
        ;;
    docker-direct-stop)
        container_paths "${1:?缺少基础目录}" "${2:?缺少名称}"
        [[ -f $CONTAINER/.xtmoe-chroot ]] || die '容器不存在'
        direct_docker_stop
        ;;
    docker-direct-status)
        container_paths "${1:?缺少基础目录}" "${2:?缺少名称}"
        [[ -f $CONTAINER/.xtmoe-chroot ]] || die '容器不存在'
        direct_docker_status
        ;;
    docker-direct-logs)
        container_paths "${1:?缺少基础目录}" "${2:?缺少名称}"
        [[ -f $CONTAINER/.xtmoe-chroot ]] || die '容器不存在'
        direct_docker_logs
        ;;
    docker-direct-run-test)
        container_paths "${1:?缺少基础目录}" "${2:?缺少名称}"
        [[ -f $CONTAINER/.xtmoe-chroot ]] || die '容器不存在'
        direct_docker_run_test
        ;;
    systemd-check)
        container_paths "${1:?缺少基础目录}" "${2:?缺少名称}"
        systemd_check
        ;;
    systemd-start)
        container_paths "${1:?缺少基础目录}" "${2:?缺少名称}"
        systemd_start "${3:-}"
        ;;
    systemd-login)
        container_paths "${1:?缺少基础目录}" "${2:?缺少名称}"
        systemd_login
        ;;
    systemd-exec)
        container_paths "${1:?缺少基础目录}" "${2:?缺少名称}"
        shift 2
        systemd_exec "$@"
        ;;
    systemd-status)
        container_paths "${1:?缺少基础目录}" "${2:?缺少名称}"
        systemd_status
        ;;
    systemd-stop)
        container_paths "${1:?缺少基础目录}" "${2:?缺少名称}"
        systemd_stop
        ;;
    install)
        container_paths "${1:?缺少基础目录}" "${2:?缺少名称}"
        archive=${3:?缺少镜像}; shift 3
        install_rootfs "$archive" "$@"
        ;;
    login)
        container_paths "${1:?缺少基础目录}" "${2:?缺少名称}"
        if systemd_running; then
            systemd_login
        elif direct_docker_running; then
            guest_interactive_login direct_docker_exec
        else
            run_chroot "${3:-}"
        fi
        ;;
    exec)
        container_paths "${1:?缺少基础目录}" "${2:?缺少名称}"
        config=${3:-}; shift 3
        (($#)) || die '缺少命令'
        if systemd_running; then
            systemd_exec "$@"
        elif direct_docker_running; then
            direct_docker_exec "$@"
        else
            run_chroot "$config" "$@"
        fi
        ;;
    stop)
        container_paths "${1:?缺少基础目录}" "${2:?缺少名称}"
        [[ -f $CONTAINER/.xtmoe-chroot ]] || die '容器不存在'
        if systemd_running; then
            systemd_stop
        elif direct_docker_running; then
            direct_docker_stop
        else
            unmount_all "$ROOTFS" || die '部分挂载无法卸载，可能仍有进程占用'
        fi
        ;;
    status)
        container_paths "${1:?缺少基础目录}" "${2:?缺少名称}"
        [[ -f $CONTAINER/.xtmoe-chroot ]] || die '容器不存在'
        if systemd_running; then
            printf 'systemd\n'
        elif direct_docker_running; then
            printf 'direct-docker\n'
        elif is_mounted "$ROOTFS"; then
            printf 'mounted\n'
        else
            printf 'stopped\n'
        fi
        ;;
    backup)
        container_paths "${1:?缺少基础目录}" "${2:?缺少名称}"
        backup_container "${3:?缺少输出文件}" "${4:?缺少 uid}" "${5:?缺少 gid}"
        ;;
    restore)
        container_paths "${1:?缺少基础目录}" "${2:?缺少名称}"
        restore_container "${3:?缺少备份文件}"
        ;;
    remove)
        container_paths "${1:?缺少基础目录}" "${2:?缺少名称}"
        remove_container
        ;;
    *) die "未知操作：$ACTION" ;;
esac
