#!/data/data/com.termux/files/usr/bin/bash
set -Eeuo pipefail

TMOE_VERSION='2.0.0-dev'
SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)

if [[ -r "$SCRIPT_DIR/../lib/common.sh" ]]; then
    TMOE_LIB_DIR=$(cd -- "$SCRIPT_DIR/../lib" && pwd)
else
    TMOE_LIB_DIR="${PREFIX:?PREFIX 未设置}/libexec/tmoe-termux/lib"
fi

source "$TMOE_LIB_DIR/common.sh"
source "$TMOE_LIB_DIR/proot.sh"
source "$TMOE_LIB_DIR/chroot.sh"

show_help() {
    cat <<'EOF'
TMOE Termux v2

用法：
  tmoe doctor
  tmoe proot  <操作> [参数]
  tmoe chroot <操作> [参数]
  tmoe migrate scan
  tmoe version
  tmoe help

常用示例：
  tmoe proot install ubuntu:24.04 ubuntu
  tmoe proot login ubuntu
  tmoe proot exec ubuntu -- uname -a
  tmoe chroot install ubuntu 24.04 ubuntu
  tmoe chroot login ubuntu
  tmoe chroot stop ubuntu

运行 `tmoe proot help` 或 `tmoe chroot help` 查看模式专用帮助。
EOF
}

migrate_help() {
    cat <<'EOF'
旧版 TMOE 只读迁移检查

  tmoe migrate scan

scan 只读取旧版容器、配置、备份和 /proc/mounts，不修改任何文件。
迁移步骤见 docs/MIGRATION.md。
EOF
}

migrate_scan() {
    local legacy_data="$TMOE_HOME/.local/share/tmoe-linux" legacy_config="$TMOE_HOME/.config/tmoe-linux"
    local legacy_containers="$legacy_data/containers" mode path found=0 mount_state
    info '扫描旧版 TMOE 数据（只读）'

    for mode in proot chroot; do
        if [[ -d $legacy_containers/$mode ]]; then
            for path in "$legacy_containers/$mode"/*; do
                [[ -d $path ]] || continue
                found=1
                mount_state=''
                if [[ $mode == chroot ]]; then
                    if awk -v p="$path" '$2 == p || index($2, p "/") == 1 { found=1 } END { exit !found }' /proc/mounts 2>/dev/null; then
                        mount_state=' [仍有挂载：禁止移动或删除]'
                    else
                        mount_state=' [未发现挂载]'
                    fi
                fi
                printf '旧 %-6s %s%s\n' "$mode" "$path" "$mount_state"
            done
        fi
    done

    if [[ -d $legacy_config ]]; then
        found=1
        printf '旧 config %s\n' "$legacy_config"
    fi

    for path in \
        "$TMOE_HOME/storage/downloads/backup/containers" \
        /sdcard/Download/backup/containers; do
        if [[ -d $path ]]; then
            found=1
            printf '旧 backup %s\n' "$path"
        fi
    done

    if ((found == 0)); then
        ok '未发现旧版 TMOE 数据'
    else
        warn '扫描只报告位置；不要直接导入整个旧 rootfs，请按 docs/MIGRATION.md 迁移数据。'
    fi
}

migrate_main() {
    local action=${1:-help}
    shift || true
    case "$action" in
        scan) (($# == 0)) || die 'migrate scan 不接受额外参数'; migrate_scan ;;
        help|-h|--help) migrate_help ;;
        *) die "未知迁移操作：$action" ;;
    esac
}

doctor() {
    local failures=0 android_release='未知' root_state='不可用' architecture available_kb apk_release

    info "TMOE $TMOE_VERSION 环境检查"
    if is_termux; then
        ok "Termux 环境：${PREFIX:-未知}"
    else
        warn '当前不是可识别的 Termux 环境'
        ((failures += 1))
    fi

    if command_exists getprop; then
        android_release=$(getprop ro.build.version.release 2>/dev/null || true)
    fi
    architecture=$(uname -m)
    info "Android：${android_release:-未知}；架构：$architecture"
    case "$architecture" in
        aarch64|arm64|armv7l|armv8l|arm|x86_64|amd64) ;;
        *) warn "当前架构尚未列入 Chroot 支持矩阵：$architecture" ;;
    esac

    apk_release=${TERMUX_APK_RELEASE:-${TERMUX_APP__APK_RELEASE:-未知}}
    info "Termux APK 来源：$apk_release"
    case "${apk_release^^}" in
        *GOOGLE*PLAY*|*PLAY*STORE*)
            warn '检测到旧 Google Play Termux 来源；请迁移至 F-Droid 或官方 GitHub 版本'
            ((failures += 1))
            ;;
    esac

    if [[ $(id -u) -eq 0 ]]; then
        warn '当前会话是 Root；请退出 su/tsu 后再运行 tmoe'
        ((failures += 1))
    else
        ok '当前为 Termux 普通用户'
    fi

    for cmd in bash curl tar sha256sum; do
        if command_exists "$cmd"; then
            ok "命令：$cmd"
        else
            warn "缺少命令：$cmd"
            ((failures += 1))
        fi
    done

    if command_exists proot-distro; then
        ok "PRoot：$(proot-distro --version 2>/dev/null | head -n 1 || printf '已安装')"
    else
        warn 'PRoot：缺少 proot-distro（执行 pkg install proot-distro）'
    fi

    if root_available; then
        root_state='可用'
        ok "Root：$root_state"
        for cmd in mount umount chroot; do
            if command_exists "$cmd"; then
                ok "Chroot 命令：$cmd"
            else
                warn "Root 可用但缺少 Chroot 命令：$cmd（执行 tmoe chroot prepare）"
            fi
        done
    else
        info 'Root：不可用；PRoot 不受影响，Chroot 不可用'
    fi

    if [[ -d /sdcard || -d /storage/emulated/0 ]]; then
        ok 'Android 共享存储目录存在'
    else
        info '未发现共享存储；如需访问，请执行 termux-setup-storage'
    fi

    available_kb=$(df -Pk "$TMOE_HOME" 2>/dev/null | awk 'NR == 2 { print $4 }' || true)
    if [[ $available_kb =~ ^[0-9]+$ ]]; then
        info "可用空间：$((available_kb / 1024)) MiB"
        if ((available_kb < 1048576)); then
            warn '可用空间低于 1 GiB，安装 Linux 容器可能失败'
        fi
    fi

    if [[ -d $TMOE_HOME/.local/share/tmoe-linux/containers || -d $TMOE_HOME/.config/tmoe-linux ]]; then
        warn '检测到旧版 TMOE 数据；不要直接移动或删除，先阅读 docs/MIGRATION.md'
    fi

    if ((failures > 0)); then
        warn "检查完成：发现 $failures 个基础问题"
        return 1
    fi
    ok '检查完成：基础环境可用'
}

main() {
    local command=${1:-help}
    shift || true
    case "$command" in
        doctor) doctor "$@" ;;
        proot) proot_main "$@" ;;
        chroot) chroot_main "$@" ;;
        migrate) migrate_main "$@" ;;
        version|-V|--version) printf 'tmoe %s\n' "$TMOE_VERSION" ;;
        help|-h|--help) show_help ;;
        *) die "未知命令：$command（执行 tmoe help 查看帮助）" ;;
    esac
}

main "$@"

