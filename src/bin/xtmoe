#!/data/data/com.termux/files/usr/bin/bash
set -Eeuo pipefail

XTMOE_VERSION='v1.0.0'
SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)

if [[ -r "$SCRIPT_DIR/../lib/common.sh" ]]; then
    XTMOE_LIB_DIR=$(cd -- "$SCRIPT_DIR/../lib" && pwd)
else
    XTMOE_LIB_DIR="${PREFIX:?PREFIX 未设置}/libexec/xtmoe/lib"
fi

source "$XTMOE_LIB_DIR/common.sh"
source "$XTMOE_LIB_DIR/proxy.sh"
source "$XTMOE_LIB_DIR/proot.sh"
source "$XTMOE_LIB_DIR/chroot.sh"
source "$XTMOE_LIB_DIR/manager.sh"

show_help() {
    printf 'XTMOE %s\n\n' "$XTMOE_VERSION"
    cat <<'EOF'
用法：
  xtmoe on                          管理向导（安装、服务、网络、代理、数据和维护）
  xtmoe doctor                      环境与能力检查
  xtmoe list [--all|--running] [--no-prompt]
  xtmoe proot install [镜像] [名称]  默认 ubuntu:24.04 / ubuntu
  xtmoe proot login [名称]
  xtmoe proot exec <名称> -- <命令>
  xtmoe proot list|ps
  xtmoe proot stop <名称>
  xtmoe proot backup <名称> [文件]
  xtmoe proot update-system|status [名称]
  xtmoe chroot prepare
  xtmoe chroot install [ubuntu] [24.04] [名称]
  xtmoe chroot systemd-login [名称]   按容器实际运行方式进入
  xtmoe chroot stop|status [名称]
  xtmoe uninstall [--yes] <proot|chroot> <名称>
  xtmoe version
  xtmoe help

更多功能通过 xtmoe on 操作；模式帮助：xtmoe proot help / xtmoe chroot help。
EOF
}

source_root() {
    local source_file="${PREFIX:?PREFIX 未设置}/libexec/xtmoe/source-root" root=''
    [[ -r $source_file ]] || die '缺少源码位置记录；请在 XTMOE 源码目录重新执行 sh termux.sh'
    IFS= read -r root <"$source_file"
    [[ -n $root && -d $root/.git && -r $root/termux.sh && -r $root/src/bin/xtmoe ]] ||
        die "源码目录无效：${root:-未记录}；请重新克隆 XTMOE 并执行 sh termux.sh"
    printf '%s' "$root"
}

update_main() {
    (($# == 0)) || die 'xtmoe on → 程序维护 → 更新程序 不接受额外参数'
    require_termux
    require_command git '执行 pkg install git'
    local root status new_version
    root=$(source_root)
    status=$(git -C "$root" status --porcelain --untracked-files=no)
    [[ -z $status ]] || die "源码目录存在未提交修改，拒绝覆盖：$root"
    info "更新源码：$root"
    git -C "$root" pull --ff-only
    info '原子更新已安装命令和模块'
    sh "$root/termux.sh"
    new_version=$(bash "${PREFIX:?PREFIX 未设置}/bin/xtmoe" version)
    ok "更新完成：$new_version"
}

uninstall_app_main() {
    local yes=0 argument
    for argument in "$@"; do
        case "$argument" in
            --yes|-y) yes=1 ;;
            *) die "未知参数：$argument" ;;
        esac
    done
    require_termux
    ((yes)) && export XTMOE_YES=1
    confirm '卸载 XTMOE 程序？容器、配置、缓存和备份都会保留' || { info '已取消'; return 0; }
    local command_path="${PREFIX:?PREFIX 未设置}/bin/xtmoe"
    local library_path="$PREFIX/libexec/xtmoe"
    [[ $command_path == */files/usr/bin/xtmoe && $library_path == */files/usr/libexec/xtmoe ]] ||
        die '安装路径不符合 Termux 布局，拒绝卸载'
    rm -f -- "$command_path"
    rm -rf -- "$library_path"
    ok 'XTMOE 程序已卸载；容器和用户数据未删除'
}

uninstall_main() {
    local mode name yes=0 argument
    local -a positional=()
    for argument in "$@"; do
        case "$argument" in
            --yes|-y) yes=1 ;;
            *) positional+=("$argument") ;;
        esac
    done
    ((${#positional[@]} == 2)) || die '用法：xtmoe uninstall [--yes] <proot|chroot> <名称>'
    mode=${positional[0]}
    name=${positional[1]}
    [[ $mode == proot || $mode == chroot ]] || die "未知模式：$mode（只能是 proot 或 chroot）"
    require_name "$name"

    local -a remove_args=(remove "$name")
    ((yes)) && remove_args+=(--yes)
    case "$mode" in
        proot) proot_main "${remove_args[@]}" ;;
        chroot) chroot_main "${remove_args[@]}" ;;
    esac
}

doctor() { capability_report "$@"; }

main() {
    local command=${1:-help}
    shift || true
    case "$command" in
        on|help|-h|--help|version|-V|--version) ;;
        *) proxy_load || return 1 ;;
    esac
    case "$command" in
        doctor) doctor "$@" ;;
        on) on_main "$@" ;;
        list) list_main "$@" ;;
        proot) public_proot "$@" ;;
        chroot) public_chroot "$@" ;;
        uninstall) uninstall_main "$@" ;;
        version|-V|--version) printf 'xtmoe %s\n' "$XTMOE_VERSION" ;;
        help|-h|--help) show_help ;;
        *) die "未知或未公开的命令：$command；请运行 xtmoe on 或 xtmoe help" ;;
    esac
}

if [[ ${BASH_SOURCE[0]} == "$0" ]]; then main "$@"; fi

